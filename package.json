{
  "name": "@brigadasos/nadeshiko-sdk-monorepo",
  "version": "1.0.0",
  "description": "Nadeshiko SDK Monorepo - TypeScript SDKs for Nadeshiko API",
  "private": true,
  "license": "MIT",
  "author": "BrigadaSOS",
  "workspaces": {
    "packages": [
      "sdk",
      "sdk-internal"
    ]
  },
  "scripts": {
    "generate": "bun run scripts/generate-package.ts public",
    "generate:internal": "bun run scripts/generate-package.ts internal",
    "generate:all": "bun run scripts/generate-package.ts all",
    "generate:local": "bun run scripts/generate-package.ts all ../Nadeshiko/backend/docs/generated/openapi.yaml",
    "check:boundaries": "bun run scripts/check-public-boundary.ts",
    "release:validate": "bun run scripts/release/validate-payload.ts",
    "release:check-npm-version": "bun run scripts/release/check-npm-version.ts",
    "release:set-version": "bun run scripts/release/set-version.ts",
    "build": "bun run build:public && bun run build:internal",
    "build:public": "bun run scripts/build-package.ts sdk",
    "build:internal": "bun run scripts/build-package.ts sdk-internal",
    "clean": "rm -rf sdk/dist sdk-internal/dist"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.90.9",
    "@types/bun": "latest",
    "typescript": "^5",
    "yaml": "^2.8.2"
  }
}
