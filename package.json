{
  "name": "@brigadasos/nadeshiko-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Nadeshiko API",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "BrigadaSOS",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrigadaSOS/nadeshiko-sdk-ts.git"
  },
  "homepage": "https://nadeshiko.co",
  "bugs": {
    "url": "https://github.com/BrigadaSOS/nadeshiko-sdk-ts/issues"
  },
  "keywords": [
    "nadeshiko",
    "japanese",
    "anime",
    "sentences",
    "search",
    "api",
    "sdk",
    "typescript",
    "openapi"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "generate": "openapi-ts",
    "build": "bun run clean && tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.90.9",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
