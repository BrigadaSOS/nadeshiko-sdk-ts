{
  "name": "@brigadasos/nadeshiko-sdk-monorepo",
  "version": "1.0.0",
  "description": "Nadeshiko SDK Monorepo - TypeScript SDKs for Nadeshiko API",
  "private": true,
  "license": "MIT",
  "author": "BrigadaSOS",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "generate": "bun run scripts/generate.ts",
    "generate:public": "bun run scripts/generate.ts",
    "generate:internal": "SDK_TYPE=internal bun run scripts/generate.ts",
    "generate:local": "OPENAPI_SPEC_PATH=../Nadeshiko/backend/docs/generated/openapi.yaml bun run scripts/generate.ts",
    "generate:local:internal": "SDK_TYPE=internal OPENAPI_SPEC_PATH=../Nadeshiko/backend/docs/generated/openapi.yaml bun run scripts/generate.ts",
    "check:boundaries": "bun run scripts/check-public-boundary.ts",
    "release:validate": "bun run scripts/release/validate-payload.ts",
    "release:check-npm-version": "bun run scripts/release/check-npm-version.ts",
    "release:set-version": "bun run scripts/release/set-version.ts",
    "build": "bun run build:public && bun run build:internal",
    "build:public": "bun run --filter './packages/sdk' build",
    "build:internal": "bun run --filter './packages/internal-sdk' build",
    "clean": "rm -rf packages/*/dist"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.90.9",
    "@types/bun": "latest",
    "typescript": "^5",
    "yaml": "^2.8.2"
  }
}
