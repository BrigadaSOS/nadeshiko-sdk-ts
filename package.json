{
  "name": "@brigadasos/nadeshiko-sdk-build",
  "version": "1.4.0",
  "description": "TypeScript SDK for Nadeshiko API",
  "private": true,
  "license": "MIT",
  "author": "BrigadaSOS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrigadaSOS/nadeshiko-sdk-ts.git"
  },
  "homepage": "https://nadeshiko.co",
  "bugs": {
    "url": "https://github.com/BrigadaSOS/nadeshiko-sdk-ts/issues"
  },
  "keywords": [
    "nadeshiko",
    "japanese",
    "anime",
    "sentences",
    "search",
    "api",
    "sdk",
    "typescript",
    "openapi"
  ],
  "scripts": {
    "codegen": "bun run codegen:public && bun run codegen:internal && bun run codegen:dev",
    "codegen:public": "SDK_TYPE=public bun run scripts/generate.ts",
    "codegen:internal": "SDK_TYPE=internal bun run scripts/generate.ts",
    "codegen:dev": "SDK_TYPE=dev bun run scripts/generate.ts",
    "pack": "bun run pack:public && bun run pack:internal && bun run pack:dev",
    "pack:public": "bun run scripts/build-package.ts public",
    "pack:internal": "bun run scripts/build-package.ts internal",
    "pack:dev": "bun run scripts/build-package.ts dev",
    "clean": "rm -rf build generated"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.90.9",
    "@types/bun": "latest",
    "typescript": "^5",
    "yaml": "^2.8.2"
  }
}
