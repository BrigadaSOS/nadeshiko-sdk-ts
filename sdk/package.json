{
  "name": "@brigadasos/nadeshiko-sdk",
  "version": "1.3.0",
  "description": "TypeScript SDK for Nadeshiko API (public endpoints only)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "BrigadaSOS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrigadaSOS/nadeshiko-sdk-ts.git"
  },
  "homepage": "https://nadeshiko.co",
  "bugs": {
    "url": "https://github.com/BrigadaSOS/nadeshiko-sdk-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nadeshiko",
    "japanese",
    "anime",
    "sentences",
    "search",
    "api",
    "sdk",
    "typescript",
    "openapi"
  ],
  "scripts": {
    "build": "bun run ../scripts/build-package.ts .",
    "prepack": "cp ../README.md ./README.md",
    "postpack": "rm -f ./README.md"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
