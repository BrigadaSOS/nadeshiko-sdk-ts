# OpenAPI spec source for code generation.
#
# Use the remote URL (default) to work against the published spec. Works out
# of the box without cloning the backend repo:
OPENAPI_SPEC_PATH=https://raw.githubusercontent.com/BrigadaSOS/Nadeshiko/main/backend/docs/generated/openapi.yaml

# To iterate against a local backend checkout with a BUNDLED spec (all $refs
# resolved into a single file), point this at the bundled file instead:
# OPENAPI_SPEC_PATH=../Nadeshiko/backend/docs/generated/openapi.bundled.yaml
#
# The raw openapi.yaml in the backend repo contains external $refs to
# schema files. Codegen will fail if those files aren't present locally —
# use the remote URL above, or bundle the spec first via the backend's
# bundling script.
